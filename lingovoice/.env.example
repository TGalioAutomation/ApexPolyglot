# LingoVoice — cấu hình. KHÔNG COMMIT file .env (đã gitignore).
PORT=4174
HOST=0.0.0.0
# Khuyến nghị bắt buộc khi mở app ra Internet; bỏ trống chỉ khi chạy local.
APP_ACCESS_USER=student
APP_ACCESS_PASSWORD=
# Giới hạn payload JSON để tránh request quá lớn (byte).
MAX_BODY_BYTES=65536
OPENVOX_API=http://127.0.0.1:8000/v1

# Model theo ngôn ngữ (supertonic-3 giọng EN tự nhiên; kokoro có giọng tiếng Trung)
OPENVOX_EN_MODEL=supertonic-3
OPENVOX_ZH_MODEL=kokoro
# Giọng mặc định (nếu giọng không tồn tại trên model thì tự chọn giọng đầu tiên hợp lệ)
OPENVOX_EN_VOICE=F1
OPENVOX_ZH_VOICE=zf_xiaoxiao

# --- Giáo viên AI (chọn 1 trong 3) ---
# AI_PROVIDER=auto ưu tiên theo key có sẵn: gemini -> deepseek -> openai
AI_PROVIDER=auto

# Bỏ 1 trong các dòng dưới đây
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_BASE=https://api.deepseek.com

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
