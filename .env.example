PORT=4173
# PostgreSQL (V1). Nếu bỏ trống, app chạy prototype local không cần DB.
DATABASE_URL=postgres://lingopilot:lingopilot_dev@127.0.0.1:5432/lingopilot
# Trong Docker Compose dùng network nội bộ:
# DATABASE_URL=postgres://lingopilot:lingopilot_dev@db:5432/lingopilot
# auto ưu tiên Gemini -> DeepSeek -> OpenAI; hoặc đặt gemini/deepseek/openai
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
# provider tương thích cũ, không bắt buộc
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENVOX_API=http://127.0.0.1:8000/v1
OPENVOX_MODEL=kokoro
# optional; if omitted the app discovers the first compatible voice
OPENVOX_VOICE=
# S3-compatible object storage (P3 media upload). Bỏ trống để tắt media upload.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
